<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовый TextView: шрифт по умолчанию. Задаём ТОЛЬКО fontFamily (без android:) —
         наследники переопределяют его одной строкой. -->
    <style name="Widget.PlaylistMaker.TextView" parent="android:Widget.TextView">
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <!-- Все Material-кнопки: свой шрифт + без КАПСа. -->
    <style name="Widget.PlaylistMaker.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <!-- Кнопки главного экрана: белый фон, иконка слева, растянуты по высоте, с тенью. -->
    <style name="Widget.PlaylistMaker.Button.Main" parent="Widget.PlaylistMaker.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/button_text</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">@color/black</item>
        <item name="elevation">@dimen/button_elevation</item>
        <item name="rippleColor">@color/button_ripple</item>
    </style>

    <!-- Корневой контейнер контентных экранов. -->
    <style name="Widget.PlaylistMaker.Screen" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/background_surface</item>
    </style>

    <!-- Контейнер шапки экрана. -->
    <style name="Widget.PlaylistMaker.Header" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">@dimen/margin_bottom</item>
        <item name="android:layout_marginBottom">@dimen/margin_bottom</item>
    </style>

    <!-- Кнопка "назад" в шапке. -->
    <style name="Widget.PlaylistMaker.BackButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">@dimen/icon_padding</item>
        <item name="android:src">@drawable/back_button</item>
    </style>

    <!-- Заголовок экрана в шапке. -->
    <style name="Widget.PlaylistMaker.ScreenTitle" parent="Widget.PlaylistMaker.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">@dimen/text_header</item>
    </style>

    <!-- Заглушка-сообщение по центру экрана. -->
    <style name="Widget.PlaylistMaker.Message" parent="Widget.PlaylistMaker.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.PlaylistMaker.SettingRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/item_height</item>
        <item name="android:padding">@dimen/margin_bottom</item>
    </style>

    <style name="Widget.PlaylistMaker.SettingLabel" parent="Widget.PlaylistMaker.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">@dimen/item_text_size</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="Widget.PlaylistMaker.SettingIcon" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

</resources>
