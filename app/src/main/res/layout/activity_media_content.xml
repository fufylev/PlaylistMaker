<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PlaylistMaker.Screen"
    android:id="@+id/activity_media_content"
    tools:context=".MediaContentActivity"
    tools:ignore="UseCompoundDrawables">

    <LinearLayout style="@style/Widget.PlaylistMaker.Header">

        <ImageView
            android:id="@+id/back_button"
            style="@style/Widget.PlaylistMaker.BackButton"
            android:contentDescription="@string/back" />

        <TextView
            style="@style/Widget.PlaylistMaker.ScreenTitle"
            android:text="@string/media" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/Widget.PlaylistMaker.Message"
        android:text="Это экран медиатеки" />

</LinearLayout>
